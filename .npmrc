# Electron's binary comes from GitHub releases, which is unreachable from this
# network: `npm install` succeeds (the JS package downloads fine) but the 240 MB
# executable silently fails later, and the failure only shows up the first time
# you launch the desktop shell — as "Electron failed to install correctly".
#
# The mirror serves byte-identical artifacts. Delete this file if your network
# can reach github.com, or override with ELECTRON_MIRROR for one command.
electron_mirror=https://npmmirror.com/mirrors/electron/
