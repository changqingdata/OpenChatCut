{
  "id": "bar-compare",
  "name": "条形对比",
  "nameEn": "Bar compare",
  "intent": "两个量并排比长度，用来讲倍数、落差、A 是 B 的几倍",
  "box": { "width": 900, "height": 520 },
  "params": {
    "aLabel": { "type": "string", "required": true, "maxChars": 10 },
    "aValue": { "type": "number", "required": true },
    "bLabel": { "type": "string", "required": true, "maxChars": 10 },
    "bValue": { "type": "number", "required": true },
    "unit": { "type": "string", "maxChars": 3, "description": "单位，如 × 或 %" },
    "title": { "type": "string", "maxChars": 14 },
    "aColor": { "type": "color", "default": "#8A857C", "description": "第一条的颜色，默认压暗" },
    "bColor": { "type": "color", "default": "#E8B04B", "description": "第二条的颜色，默认强调" },
    "bg": { "type": "color", "default": "" },
    "ink": { "type": "color", "default": "#F2EFE9" },
    "muted": { "type": "color", "default": "#8A857C" },
    "displayFont": { "type": "font", "default": "Smiley Sans" },
    "bodyFont": { "type": "font", "default": "Noto Sans SC" }
  }
}
