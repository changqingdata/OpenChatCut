{
  "id": "stack-share",
  "name": "构成条",
  "nameEn": "Stacked share",
  "intent": "把总量拆成几块，看每块占多少，用来讲「钱花在哪」「时间用在哪」",
  "box": { "width": 900, "height": 380 },
  "params": {
    "parts": {
      "type": "array",
      "required": true,
      "maxItems": 4,
      "itemMaxChars": 8,
      "description": "2–4 个构成项"
    },
    "values": {
      "type": "array",
      "required": true,
      "maxItems": 4,
      "itemMaxChars": 6,
      "description": "与 parts 一一对应的数值，只写数字；不必加起来等于 100"
    },
    "title": { "type": "string", "maxChars": 14 },
    "unit": { "type": "string", "maxChars": 2, "default": "%" },
    "bg": { "type": "color", "default": "" },
    "ink": { "type": "color", "default": "#F2EFE9" },
    "accent": { "type": "color", "default": "#E8B04B" },
    "muted": { "type": "color", "default": "#8A857C" },
    "displayFont": { "type": "font", "default": "Smiley Sans" },
    "bodyFont": { "type": "font", "default": "Noto Sans SC" }
  }
}
