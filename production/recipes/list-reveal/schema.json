{
  "id": "list-reveal",
  "name": "清单逐条",
  "nameEn": "List Reveal",
  "intent": "把两到四个要点逐条推出来，用于步骤、理由、并列观点。条目越多节奏越慢，超过四条就会挤。",
  "box": {
    "width": 900,
    "height": 760
  },
  "jobs": ["relation"],
  "landscapeBox": { "width": 1500, "height": 520 },
  "params": {
    "items": {
      "type": "array",
      "required": true,
      "maxItems": 4,
      "itemMaxChars": 16,
      "description": "2–4 条，每条一行说完"
    },
    "title": {
      "type": "string",
      "maxChars": 12,
      "default": ""
    },
    "fontSize": {
      "type": "number",
      "default": 54,
      "min": 34,
      "max": 72
    },
    "gap": {
      "type": "number",
      "default": 34,
      "min": 12,
      "max": 64
    },
    "markWidth": {
      "type": "number",
      "default": 84,
      "min": 48,
      "max": 140
    },
    "align": {
      "type": "enum",
      "values": [
        "left",
        "center"
      ],
      "default": "left"
    },
    "bg": {
      "type": "color",
      "default": "",
      "description": "背景色，留空则透明（叠在画面上用）"
    },
    "ink": {
      "type": "color",
      "default": "#F2EFE9"
    },
    "accent": {
      "type": "color",
      "default": "#E8B04B"
    },
    "muted": {
      "type": "color",
      "default": "#8A857C"
    },
    "displayFont": {
      "type": "font",
      "default": "'Smiley Sans', 'Noto Sans SC', sans-serif"
    },
    "bodyFont": {
      "type": "font",
      "default": "'Noto Sans SC', sans-serif"
    }
  }
}
